<% layout('layouts/app') %>

<h1 class="text-center">Edit Place</h1>

<div class="col-md-6 offset-md-3">
  <form
    action="/places/<%= place._id %>?_method=PUT"
    method="POST"
    class="validated-form"
    novalidate
    enctype="multipart/form-data"
  >
    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input
        type="text"
        name="place[title]"
        id="title"
        class="form-control"
        value="<%= place.title %>"
        required
      />
      <div class="valid-feedback">Looks good!</div>
      <div class="invalid-feedback">Please fill out this field!.</div>
    </div>

    <div class="mb-3">
      <label for="location" class="form-label">Location</label>
      <input
        type="text"
        name="place[location]"
        id="location"
        class="form-control"
        value="<%= place.location %>"
        required
      />
      <div class="form-text">
        Kalau lokasi diubah, titik di peta dicari ulang otomatis.
      </div>
      <div class="valid-feedback">Looks good!</div>
      <div class="invalid-feedback">Please fill out this field!.</div>
    </div>

    <div class="mb-3">
      <label for="description" class="form-label">Description</label>
      <textarea
        name="place[description]"
        id="description"
        class="form-control"
        rows="4"
        required
      ><%= place.description %></textarea>
      <div class="valid-feedback">Looks good!</div>
      <div class="invalid-feedback">Please fill out this field!.</div>
    </div>

    <div class="mb-3">
      <label for="price" class="form-label">Price</label>
      <input
        type="number"
        name="place[price]"
        id="price"
        class="form-control"
        value="<%= place.price %>"
        min="0"
        required
      />
      <div class="valid-feedback">Looks good!</div>
      <div class="invalid-feedback">Please fill out this field!.</div>
    </div>

    <!-- gambar yang sekarang tersimpan, biar user tahu apa yang bakal diganti -->
    <% if (place.images && place.images.length) { %>
    <div class="mb-3">
      <label class="form-label">Current images</label>
      <div class="d-flex flex-wrap gap-2">
        <% place.images.forEach((image) => { %>
        <img
          src="<%= image.url %>"
          alt="<%= place.title %>"
          class="rounded border"
          style="width: 96px; height: 96px; object-fit: cover"
        />
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="mb-3">
      <label for="image" class="form-label">Replace images</label>
      <input
        type="file"
        name="image"
        id="image"
        accept="image/*"
        class="form-control"
        multiple
      />
      <div class="form-text">
        Kosongkan kalau tidak ingin mengganti gambar. Upload baru akan
        menggantikan semua gambar lama (maks 5 file, 5MB per file).
      </div>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a href="/places/<%= place._id %>" class="btn btn-secondary">Cancel</a>
  </form>
</div>
