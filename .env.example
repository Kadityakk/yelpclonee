# Salin file ini jadi .env lalu isi nilainya.
#   cp .env.example .env
# File .env sudah masuk .gitignore, jadi key-nya tidak ikut ter-commit.

# Access Key dari https://unsplash.com/developers
# Daftar -> "New Application" -> salin "Access Key" (BUKAN Secret Key).
# Tier demo gratis: 50 request per jam, cukup untuk seed 19 tempat.
UNSPLASH_ACCESS_KEY=
